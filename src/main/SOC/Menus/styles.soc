MenuItemStyle PATCHSTRING
Part 0
Part 1
	Align = Edge
	Source = Patch

MenuItemStyle SKINICONEDGE
Part 0
	Type = SkinIcon
	Align = Edge
	Source = Patch
	Source2 = Extra
	
MenuItemStyle TEXTTAG
Part 0
	TextTag = True

# lots of things previously hardcoded in M_DrawRightString, fixedstring set by hardcode

# shows the current resolution (123x456)
MenuItemStyle VIDEOMODE
Part 0
Part 1
	Align = Edge
	Source = Fixed
	NoHighlight = True

# shows the setupplayer's joystick name
MenuItemStyle JOYSTICKNAME
Part 0
Part 1
	Align = Edge
	Source = Fixed
	Highlight = Highlight

# blinking envelope for discord notifications
MenuItemStyle DISCORDREQUEST
Part 0
Part 1
	Type = Patch
	X = 164*FRACUNIT
	Y = -FRACUNIT
	Source = Fixed
	FixedString = K_REQUE2

# MP_SetupControls will automatically change any item with MR_ChangeControl to this style
# the keybinds are written to item->patch
MenuItemStyle CHANGECONTROLNAME
Part 0
Part 1
	Align = Edge
	Highlight = Highlight
	Source = Patch

# ...or this one if the binds are too long
MenuItemStyle CHANGECONTROLNAMELONG
Part 0
Part 1
	Font = TINY
	Align = Edge
	Highlight = Highlight
	Source = Patch

# used by MD_DrawJoystick
MenuItemStyle JOYSTICKLIST
Part 0
	Type = Fill
	X = -3*FRACUNIT
	Y = -3*FRACUNIT
	Source = Patch
Part 1
	NoHighlight = True

# highlights the selected joystick
MenuItemStyle JOYSTICKLISTSET
Part 0
	Type = Fill
	X = -3*FRACUNIT
	Y = -3*FRACUNIT
	Source = Patch
Part 1
	Highlight = Recommended
	NoHighlight = True

# icons for each local player
MenuItemStyle P1WANTED
Part 0
	Type = SkinIcon
	Source = Fixed
	Source2 = Fixed2

MenuItemStyle P2WANTED
Part 0
	Type = SkinIcon
	Source = Fixed
	Source2 = Fixed2

MenuItemStyle P3WANTED
Part 0
	Type = SkinIcon
	Source = Fixed
	Source2 = Fixed2

MenuItemStyle P4WANTED
Part 0
	Type = SkinIcon
	Source = Fixed
	Source2 = Fixed2

# special variants with highlights and translucency for multiplayer setup
MenuItemStyle P1MULTIPLAYER : P1WANTED

MenuItemStyle P2MULTIPLAYER : P2WANTED

MenuItemStyle P3MULTIPLAYER : P3WANTED

MenuItemStyle P4MULTIPLAYER : P4WANTED
