Menu MP_MAIN
Music = olmenu
X = 42
Y = 30
HeaderPic = M_MULTI
DrawRoutine = MD_DrawMPMainMenu
QuitRoutine = MR_CancelConnect
MenuItem PLAYERSHEADER
Style = header
Text = Players

MenuItem LOCALPLAYERS
OfsY = 2
Text = Number of local players
Cvar = splitplayers

MenuItem PLAYERSETUP
Text = Player setup...
Cvar = dummymultiplayer
SubMenu = MN_MP_PLAYERSETUP

MenuItem HOSTHEADER
OfsY = 50
Style = header
Text = Host a game

MenuItem STARTSERVER
OfsY = 2
Text = Internet/LAN...
Patch = (2-16 players)
SubMenu = MP_SERVER

MenuItem OFFLINESERVER
Text = Offline...
Patch = (2-4 players)
SubMenu = MP_SPLITSCREEN

MenuItem JOINHEADER
OfsY = 6
Style = header
Text = Join a game

MenuItem BROWSER
OfsY = 2
Text = Internet server browser...
Call = MR_ConnectMenuModChecks

MenuItem CONNECTIP
Text = Specify IPv4 address:
Cvar = dummyip
Call = MR_ConnectIP
