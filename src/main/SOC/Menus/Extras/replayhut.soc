Items
DEMOTITLE
	Style = highlight

Menu MISC_REPLAYHUT
Music = replst
BackgroundName = SRB2BACK
ScrollXSpeed = 0
ScrollYSpeed = 0
FadeStrength = 1
EnterWipe = 0
ExitWipe = 0
EnterRoutine = MR_ReplayHut
QuitRoutine = MR_QuitReplayHut
VHS = true
Panels
DEMOLIST : REPLAYHUT_DEMOLIST
	X = 30
	Y = 80
	Flags = V_SNAPTOTOP|V_SNAPTOLEFT|V_ALLOWLOWERCASE
DEMOINFOBG : REPLAYHUT_DEMOINFO_BG
	X = 10
	Y = 10
	Flags = V_SNAPTOTOP
DEMOINFOFG : REPLAYHUT_DEMOINFO_FG
	X = 10
	Y = 10
	Flags = V_SNAPTOTOP|V_ALLOWLOWERCASE

