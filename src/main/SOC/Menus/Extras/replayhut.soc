MenuPanel REPLAYHUT_DEMOSTART
Initializer = MP_ReplayHutStart
Items
LOADWATCH
	Y = 0
	Text = Load Addons and Watch
	Call = MR_HutStartReplay
NOLOADWATCH
	Y = 10
	Text = Watch Without Addons
	Call = MR_HutStartReplay
WATCH
	Y = 10
	Text = Watch Replay
	Call = MR_HutStartReplay
BACK
	Y = 30
	Text = Back
	Call = MR_GoBack

Menu MISC_REPLAYHUT
Music = replst
BackgroundName = SRB2BACK
ScrollXSpeed = 0
ScrollYSpeed = 0
FadeStrength = 1
EnterWipe = 0
ExitWipe = 0
EnterRoutine = MR_ReplayHut
QuitRoutine = MR_QuitReplayHut
TickRoutine = MR_TickReplayHut
VHS = true
Panels
DEMOLIST : REPLAYHUT_DEMOLIST
	X = 30
	Y = 80
	Flags = V_SNAPTOTOP|V_SNAPTOLEFT|V_ALLOWLOWERCASE
DEMOINFOBG : REPLAYHUT_DEMOINFO_BG
	X = 10
	Y = 10
	Flags = V_SNAPTOTOP
DEMOINFOFG : REPLAYHUT_DEMOINFO_FG
	X = 10
	Y = 10
	Flags = V_SNAPTOTOP|V_ALLOWLOWERCASE

Menu MISC_REPLAYSTART
TickRoutine = MR_TickReplayHut
Panels
MAIN : REPLAYHUT_DEMOSTART
	X = 30
	Y = 90
RANKINGS : REPLAYHUT_RANKINGS
	X = BASEVIDWIDTH-100
	Y = 62
	Flags = V_SNAPTOTOP|V_ALLOWLOWERCASE
WARNING : REPLAYHUT_ADDONWARN
	X = 4
	Y = BASEVIDHEIGHT-14
	Flags = V_SNAPTOBOTTOM|V_SNAPTOLEFT|V_ALLOWLOWERCASE
DEMOINFOBG : REPLAYHUT_DEMOINFO_BG
	X = 10
	Y = 10
	Flags = V_SNAPTOTOP
DEMOINFOFG : REPLAYHUT_DEMOINFO_FG
	X = 10
	Y = 10
	Flags = V_SNAPTOTOP|V_ALLOWLOWERCASE
