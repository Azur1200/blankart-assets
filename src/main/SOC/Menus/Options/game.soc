MenuPanel OP_GAME
Initializer = MP_GameOptions
LineHeight = 10
Items
ITEMOPTIONS
	Text = Random Item Toggles...
	Tooltip = Toggles for all in-game items.
	Submenu = OP_MONITORTOGGLE
BLANKARTOPTIONS
	Text = Gameplay Mods...
	Tooltip = Gameplay-Related modifiers.
	Submenu = OP_BLANKARTGAME
BOTOPTIONS
	Text = Bots...
	Tooltip = Bot related options.
	Submenu = OP_BLANKARTBOT
RACESPEED
	Text = Race Game Speed
	Tooltip = Driving speed of game in race mode.
	Cvar = kartspeed
BATTLESPEED
	Text = Battle Game Speed
	Tooltip = Driving speed of game in battle mode.
	Cvar = kartbattlespeed
FRANTICITEMS
	Text = Frantic Items
	Tooltip = Crazier item rolls.
	Cvar = kartfrantic
ENCORE
	Text = Encore Mode
	Tooltip = Mirror mode.
	Cvar = kartencore
NUMLAPS
	OfsY = 10
	Text = Number of Laps
	Tooltip = Number of laps.
	Cvar = numlaps
COUNTDOWN
	Text = Exit Countdown Timer
	Tooltip = Countdown for other players when people finish.
	Cvar = countdowntime
ELIMINATE
	Text = Eliminate Last
	Tooltip = Last explodes when the standings are complete.
	Cvar = karteliminatelast
TIMELIMIT
	OfsY = 10
	Text = Time Limit
	Tooltip = Time limit for battle mode.
	Cvar = timelimit
NUMBUMPERS
	Text = Starting Bumpers
	Tooltip = Number of bumpers to start with in battle mode.
	Cvar = kartbumpers
KARMA
	Text = Karma Comeback
	Tooltip = Allow players to come back via karma in battle mode.
	Cvar = kartcomeback
POWERLEVELS
	Text = Track Power Levels
	Tooltip = Use Power Levels instead of points.
	Cvar = kartusepwrlv

MenuPanel OP_BLANKARTGAME
ScrollHeight = 134
LineHeight = 10
Items
MECHANICHEAD
	OfsY = 10
	Style = header
	Text = Gameplay Mechanics
RINGS
	Text = Rings
	Tooltip = Pick up Rings to use as a on demand speedboost!
	Cvar = kartrings
PURPLEDRIFT
	Text = Purple Drift
	Tooltip = 4-Tier drift boost.
	Cvar = kartpurpledrift
SLIPDASH
	Text = Slipdash
	Tooltip = Get better turning during a sliptide and a boost afterwards!
	Cvar = kartslipdash
STACKING
	Text = Boost Stacking
	Tooltip = Allows boosts to combine to become stronger!
	Cvar = kartstacking
CHAINING
	Text = Boost Chaining
	Tooltip = Extend the length of boosts with other boosts!
	Cvar = kartchaining
CHAINOFFROAD
	Text = Chain Offroad
	Tooltip = Should extended sneakers mow offroad?
	Cvar = kartchaining_chainoffroad
SLOPEBOOST
	Text = Slope Boost
	Tooltip = When you go down slopes you go faster!
	Cvar = kartslopeboost
DRAFTING
	Text = Drafting
	Tooltip = When you trail behind someone you get a speedboost!
	Cvar = kartdrafting
AIRDROP
	Text = Air Drop
	Tooltip = When you brake in the air, you fall faster! Rings make it stronger.
	Cvar = kartairdrop
AIRTHRUST
	Text = Air Thrust
	Tooltip = When you perform a drift boost in the air, you launch forwards!
	Cvar = kartairthrust
RECOVERYDASH
	Text = Recovery Dash
	Tooltip = When you hold ACCEL + BRAKE, you resist offroad and charge a Recovery Dash!
	Cvar = kartrecoverydash
KEEPSTUFF
	Text = Keep Stuff
	Tooltip = When you respawn, you retain power items such as Invincibility and Grow!
	Cvar = kartkeepstuff
BLAN_ITEMSETTINGS
	Text = Item Settings...
	Tooltip = Customize certain items as you see fit.
	Submenu = OP_BLANITEMSETTINGS
BLAN_RANKSETTINGS
	Text = Rank Settings...
	Tooltip = Customize the Rank Score system.
	Submenu = OP_BLANRANKSETTINGS
QOLHEAD
	OfsY = 10
	Style = header
	Text = Quality of Life
BUMPSPARK
	Text = Bump Spark
	Tooltip = Decide what happens when you hit a wall while drifting.
	Cvar = kartbumpspark
BUMPSPRING
	Text = Bump Spring
	Tooltip = Maintain pogospring state after wallbump.
	Cvar = kartbumpspring
ANTIBUMP
	Text = Anti-Bump
	Tooltip = Prevent player-on-player collisions for some time at race start.
	Cvar = kartantibump
ITEMLITTER
	Text = Item Litter
	Tooltip = Players drop orbiting/trailing items on the track when hit.
	Cvar = kartitemlitter
ITEMPUSHING
	Text = Item Pushing
	Tooltip = Push dropped items away from item boxes.
	Cvar = kartitempush
PLAYERBUMP
	Text = Player Bump Setting
	Tooltip = Change how players collide with one another.
	Cvar = playerbump
TRAILSLOWDOWN
	Text = Trailing Item Slowdown
	Tooltip = When on, trailing an item behind you will eventually slow you down.
	Cvar = trailslow
WATERBRICKS
	Text = Waterskip Prevention
	Tooltip = Allows players to stop waterskipping by letting go of ACCEL.
	Cvar = kartwaterskiplock
MISCHEAD
	OfsY = 10
	Style = header
	Text = Misc
ITEMBREAKER
	Text = Item Breaker
	Tooltip = When in single player battle, Item Breaker will start. Smash the item boxes fast to win.
	Cvar = kartitembreaker
RINGSTART
	Text = Starting Rings
	Tooltip = Amount of rings a player starts with when starting a game.
	Cvar = kartringsstart
RINGCAPMAX
	Text = Maximum Rings
	Tooltip = Maximum amount of rings a player can carry.
	Cvar = kartringsmax
RINGCAPMIN
	Text = Minimum Rings
	Tooltip = Amount of rings a player can enter ring debt into.
	Cvar = kartringsmin

MenuPanel OP_BLANKARTBOT
LineHeight = 10
Items
CAP
	Text = Bot Cap
	Tooltip = Add bots to the race until the player count reaches this value.
	Cvar = kartbot_cap
DIFFICULTY
	Text = Bot Difficulty
	Tooltip = How difficult should bots be? "Off" disables bots.
	Cvar = kartbot
MODIFIER
	Text = Bot Modifier
	Tooltip = This modifies the overall difficulty of bots.
	Cvar = kartbot_modifiermax
FORCERIVAL
	Text = All Rivals
	Tooltip = Forces all bots to be rivals. Turn this on for a tougher challenge!
	Cvar = kartbot_forcerival


MenuPanel OP_BLANITEMSETTINGS
ScrollHeight = 134
LineHeight = 10
Items
INVINHEAD
	OfsY = 10
	Style = header
	Text = Invincibility
INVIN_SPD
	Text = Speedboost
	Tooltip = How fast do you want Invincibility to go?
	Cvar = vanillaboost_invincibility_speedboost
INVIN_ACL
	Text = Accelboost
	Tooltip = How fast do you want Invincibility to accelerate?
	Cvar = vanillaboost_invincibility_accelboost
INVIN_HDL
	Text = Handleboost
	Tooltip = How fast do you want Invincibility to turn?
	Cvar = vanillaboost_invincibility_handleboost
INVIN_STACKME
	Text = Make Stackable
	Tooltip = (With stacking enabled) Can boosts stack on top of Invincibility?
	Cvar = vanillaboost_invincibility_stackable
SMONITORHEAD
	OfsY = 10
	Style = header
	Text = S-Monitor
SMONITORSTARTDISTANCE
	Text = S-Monitor Start Distance
	Tooltip = At this distance value, the S-Monitor is forced into a player's slot.
	Cvar = smonitor_startdist
SMONITORDECAYDISTANCE
	Text = S-Monitor Decay Distance
	Tooltip = At this distance value, the S-Monitor's time limit begins.
	Cvar = smonitor_decaydist
SMONITOR_SPD
	Text = Speedboost
	Tooltip = How fast do you want the S-Monitor to go?
	Cvar = vanillaboost_smonitor_speedboost
SMONITOR_ACL
	Text = Accelboost
	Tooltip = How fast do you want the S-Monitor to accelerate?
	Cvar = vanillaboost_smonitor_speedboost
SMONITOR_HDL
	Text = Handleboost
	Tooltip = How fast do you want the S-Monitor to turn?
	Cvar = vanillaboost_smonitor_handleboost
SMONITOR_STACKME
	Text = Make Stackable
	Tooltip = (With stacking enabled) Can boosts stack on top of the S-Monitor?
	Cvar = vanillaboost_smonitor_stackable
GROWHEAD
	OfsY = 10
	Style = header
	Text = Grow
GROW_AIRSQUISH
	Text = Air Squish
	Tooltip = Should Grow be allowed to squish other racers mid-air?
	Cvar = kartairsquish
BUBBLEHEAD
	OfsY = 10
	Style = header
	Text = Bubble Shield
BUBBLE_DEFENSE
	Text = Inflated Damage Rate
	Tooltip = At what rate should the Bubble Shield be damaged by when inflated?
	Cvar = kartbubble_defense_damagerate
BUBBLE_BOOST
	Text = Pop to Boost
	Tooltip = Should the Bubble Shield cause the user to recieve a boost when popped early?
	Cvar = kartbubble_boost_allow
BUBBLE_IDLE
	Text = Passive Defense
	Tooltip = Should the Bubble Shield passively defend from attacks when not inflated?
	Cvar = kartbubble_defense_canidle
FLAMEHEAD
	OfsY = 10
	Style = header
	Text = Flame Shield
FLAME_FASTFUEL
	Text = Fast Fuel
	Tooltip = Should the Flame Shield heat up faster in exchange for increased fuel consumption?
	Cvar = kartflame_fastfuel
FLAME_OFFROAD
	Text = Offroad Burn
	Tooltip = Should the Flame Shield grant the user offroad resistance when overheating offroad?
	Cvar = kartflame_offroadburn

MenuPanel OP_BLANRANKSETTINGS
ScrollHeight = 134
LineHeight = 10
Items
RANK_TOGGLE
	Text = Race Ranks
	Tooltip = When enabled, players are ranked by their overall game performance.
	Cvar = raceranks
INVIN_ACL
	Text = Penalties
	Tooltip = Do you want players to be penalized for certain actions?
	Cvar = racerankpenalties
RANKBONUSHEAD
	OfsY = 10
	Style = header
	Text = Rank Bonuses
INVIN_HDL
	Text = Drift Bonus
	Tooltip = Do you want players to earn points for drift-boosting?
	Cvar = rank_driftbonus
INVIN_STACKME
	Text = Hit Bonus
	Tooltip = Do you want players to earn points for hitting others?
	Cvar = rank_hitbonus
RANKPTBALANCEHEAD
	OfsY = 10
	Style = header
	Text = Rank Point Balance Adjustment
RANKLAWNMOWERTICS
	Text = Lawnmower Threshold
	Tooltip = The time (in seconds) before the player is penalized for driving offroad.
	Cvar = rank_lawnmowerthreshold
RANKHAZARDMERCY
	Text = Hazard Damage Threshold
	Tooltip = How many times can players take damage from hazards before being penalized?
	Cvar = rank_hazardmercy
RANKRESPAWNMERCY
	Text = Respawn Threshold
	Tooltip = How many times can players respawn before being penalized?
	Cvar = rank_respawnmercy
RANKLAPGRDHEAD
	OfsY = 10
	Style = header
	Text = Lap Grading
RANKLAPGRADEMUL
	Text = With Penalties
	Tooltip = The value multipler for Lap Grading (between -100 and 100).
	Cvar = rank_lapgrademul
RANKLAPGRADEMULNOPENALTY
	Text = Without Penalties
	Tooltip = The value multipler for Lap Grading when penalties are off (between -100 and 100).
	Cvar = rank_lapgrademul_penaltiesoff
RANKPOINTHEAD
	OfsY = 10
	Style = header
	Text = Rank Point Values
RANKPARPTS
	Text = Par-Time Points
	Tooltip = This value constantly decreases due to a set course's time limit.
	Cvar = rank_partimepoints
RANKPOSITIONPTS
	Text = Position Bonus Points
	Tooltip = The points you earn over time based on position.
	Cvar = rank_leadertimepoints
RANKSPBATKPTS
	Text = SPB-Attack Bonus Points
	Tooltip = The points you earn over time for being chased by an SPB. More points for closer calls!
	Cvar = rank_spbtimepoints
RANKSTARTBOOSTPTS
	Text = Starboost Bonus Points
	Tooltip = The points you earn based on how well you do the starting countdown boost.
	Cvar = rank_startboostpoints
RANKDRIFTPTS
	Text = Drift Bonus Points
	Tooltip = (With Drift Bonus enabled) The points you earn for performing drift boosts.
	Cvar = rank_driftboostpoints
RANKHITCONFIRMPTS
	Text = Hit Bonus Points
	Tooltip = (With Hit Bonus enabled) The points you earn for hitting other players.
	Cvar = rank_hitconfirmpoints
RANKOFFROADDIV
	Text = Offroad Penalty Divisor
	Tooltip = The tic delay for each point lost for driving offroad past a grace period.
	Cvar = rank_offroad_divisor
RANKWALLPTS
	Text = Wall Penalty Points
	Tooltip = The points you lose for running into walls above 75% speed.
	Cvar = rank_wallbonkpenalty
RANKHAZARDPTS
	Text = Hazard Penalty Points
	Tooltip = The points you lose for taking damage from hazards past a threshold.
	Cvar = rank_hazardpenalty
RANKRESPAWNPTS
	Text = Respawn Penalty Points
	Tooltip = The points you lose for respawning past a threshold.
	Cvar = rank_respawnpenalty

MenuPanel OP_MONITORTOGGLE
Initializer = MP_SetupMonitorToggles
KeyHandler = MR_HandleMonitorToggles
DrawRoutine = MD_DrawMonitorToggles
MultiNav = True
NavItemCount = 4

