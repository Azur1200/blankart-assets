Menu OP_GAME
X = 30
Y = 30
LineHeight = 10
HeaderPic = M_GAME
MenuItem ITEMOPTIONS
Text = Random Item Toggles...
Tooltip = Toggles for all in-game items.
Submenu = OP_MONITORTOGGLE

MenuItem BLANKARTOPTIONS
Text = Gameplay Mods...
Tooltip = Gameplay-Related modifiers.
Submenu = OP_BLANKARTGAME

MenuItem BOTOPTIONS
Text = Bots...
Tooltip = Bot related options.
Submenu = OP_BLANKARTBOT

MenuItem RACESPEED
Text = Race Game Speed
Tooltip = Driving speed of game in race mode.
Cvar = kartspeed

MenuItem BATTLESPEED
Text = Battle Game Speed
Tooltip = Driving speed of game in battle mode.
Cvar = kartbattlespeed

MenuItem FRANTICITEMS
Text = Frantic Items
Tooltip = Crazier item rolls.
Cvar = kartfrantic

MenuItem ENCORE
Text = Encore Mode
Tooltip = Mirror mode.
Cvar = kartencore

MenuItem NUMLAPS
OfsY = 10
Text = Number of Laps
Tooltip = Number of laps.
Cvar = numlaps

MenuItem COUNTDOWN
Text = Exit Countdown Timer
Tooltip = Countdown for other players when people finish.
Cvar = countdowntime

MenuItem ELIMINATE
Text = Eliminate Last
Tooltip = Last explodes when the standings are complete.
Cvar = karteliminatelast

MenuItem TIMELIMIT
OfsY = 10
Text = Time Limit
Tooltip = Time limit for battle mode.
Cvar = timelimit

MenuItem NUMBUMPERS
Text = Starting Bumpers
Tooltip = Number of bumpers to start with in battle mode.
Cvar = kartbumpers

MenuItem KARMA
Text = Karma Comeback
Tooltip = Allow players to come back via karma in battle mode.
Cvar = kartcomeback

MenuItem POWERLEVELS
Text = Track Power Levels
Tooltip = Use Power Levels instead of points.
Cvar = kartusepwrlv


Menu OP_BLANKARTGAME
X = 30
Y = 30
LineHeight = 10
ScrollHeight = 134
HeaderPic = M_GAME
MenuItem MECHANICHEAD
OfsY = 10
Style = header
Text = Gameplay Mechanics

MenuItem RINGS
Text = Rings
Tooltip = Pick up Rings to use as a on demand speedboost!
Cvar = kartrings

MenuItem PURPLEDRIFT
Text = Purple Drift
Tooltip = 4-Tier drift boost.
Cvar = kartpurpledrift

MenuItem SLIPDASH
Text = Slipdash
Tooltip = Get better turning during a sliptide and a boost afterwards!
Cvar = kartslipdash

MenuItem STACKING
Text = Boost Stacking
Tooltip = Allows boosts to combine to become stronger!
Cvar = kartstacking

MenuItem CHAINING
Text = Boost Chaining
Tooltip = Extend the length of boosts with other boosts!
Cvar = kartchaining

MenuItem CHAINOFFROAD
Text = Chain Offroad
Tooltip = Should extended sneakers mow offroad?
Cvar = kartchaining_chainoffroad

MenuItem SLOPEBOOST
Text = Slope Boost
Tooltip = When you go down slopes you go faster!
Cvar = kartslopeboost

MenuItem DRAFTING
Text = Drafting
Tooltip = When you trail behind someone you get a speedboost!
Cvar = kartdrafting

MenuItem AIRDROP
Text = Air Drop
Tooltip = When you brake in the air, you fall faster! Rings make it stronger.
Cvar = kartairdrop

MenuItem QOLHEAD
OfsY = 10
Style = header
Text = Quality of Life

MenuItem BUMPSPARK
Text = Bump Spark
Tooltip = Don't lose driftspark after wallbump.
Cvar = kartbumpspark

MenuItem BUMPSPRING
Text = Bump Spring
Tooltip = Don't lose pogospring state after wallbump.
Cvar = kartbumpspring

MenuItem ANTIBUMP
Text = Anti-Bump
Tooltip = Prevent player-on-player collisions for some time.
Cvar = kartantibump

MenuItem MISCHEAD
OfsY = 10
Style = header
Text = Misc

MenuItem ITEMBREAKER
Text = Item Breaker
Tooltip = When in single player battle, Item Breaker will start. Smash the item boxes fast to win.
Cvar = kartitembreaker

MenuItem RINGSTART
Text = Starting Rings
Tooltip = Amount of rings a player starts with when starting a game.
Cvar = kartringsstart

MenuItem RINGCAPMAX
Text = Maximum Rings
Tooltip = Maximum amount of rings a player can carry.
Cvar = kartringsmax

MenuItem RINGCAPMIN
Text = Minimum Rings
Tooltip = Amount of rings a player can enter ring debt into.
Cvar = kartringsmin


Menu OP_BLANKARTBOT
X = 30
Y = 40
LineHeight = 10
HeaderPic = M_GAME
MenuItem CAP
Text = Bot Cap
Tooltip = Add bots to the race until the player count reaches this value.
Cvar = kartbot_cap

MenuItem DIFFICULTY
Text = Bot Difficulty
Tooltip = How difficult should bots be? "Off" disables bots.
Cvar = kartbot


Menu OP_MONITORTOGGLE
X = 30
Y = 30
HeaderPic = M_GAME
KeyHandler = MR_HandleMonitorToggles
EnterRoutine = MR_SetupMonitorToggles
DrawRoutine = MD_DrawMonitorToggles
