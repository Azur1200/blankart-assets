Menu OP_GAME
X = 30
Y = 30
LineHeight = 10
HeaderPic = M_GAME
MenuItem ITEMOPTIONS
Text = Random Item Toggles...
Tooltip = Toggles for all in-game items.
Submenu = OP_MONITORTOGGLE

MenuItem BLANKARTOPTIONS
Text = Gameplay Mods...
Tooltip = Gameplay-Related modifiers.
Submenu = OP_BLANKARTGAME

MenuItem BOTOPTIONS
Text = Bots...
Tooltip = Bot related options.
Submenu = OP_BLANKARTBOT

MenuItem RACESPEED
Text = Race Game Speed
Tooltip = Driving speed of game in race mode.
Cvar = kartspeed

MenuItem BATTLESPEED
Text = Battle Game Speed
Tooltip = Driving speed of game in battle mode.
Cvar = kartbattlespeed

MenuItem FRANTICITEMS
Text = Frantic Items
Tooltip = Crazier item rolls.
Cvar = kartfrantic

MenuItem ENCORE
Text = Encore Mode
Tooltip = Mirror mode.
Cvar = kartencore

MenuItem NUMLAPS
OfsY = 10
Text = Number of Laps
Tooltip = Number of laps.
Cvar = numlaps

MenuItem COUNTDOWN
Text = Exit Countdown Timer
Tooltip = Countdown for other players when people finish.
Cvar = countdowntime

MenuItem TIMELIMIT
OfsY = 10
Text = Time Limit
Tooltip = Time limit for battle mode.
Cvar = timelimit

MenuItem NUMBUMPERS
Text = Starting Bumpers
Tooltip = Number of bumpers to start with in battle mode.
Cvar = kartbumpers

MenuItem KARMA
OfsY = 10
Text = Karma Comeback
Tooltip = Allow players to come back via karma in battle mode.
Cvar = kartcomeback

MenuItem POWERLEVELS
Text = Track Power Levels
Tooltip = Use Power Levels instead of points.
Cvar = kartusepwrlv


Menu OP_BLANKARTGAME
X = 30
Y = 40
LineHeight = 10
HeaderPic = M_GAME
MenuItem RINGS
Text = Rings
Tooltip = Pick up Rings to use as a on demand speedboost!
Cvar = kartrings

MenuItem ITEMBREAKER
Text = Item Breaker
Tooltip = Single-Player mode for battle. Collect itemboxes to win!
Cvar = kartitembreaker

MenuItem PURPLEDRIFT
Text = Purple Drift
Tooltip = 4-Tier drift boost.
Cvar = kartpurpledrift

MenuItem SLIPDASH
Text = Slipdash
Tooltip = Get better turning during a sliptide and a boost afterwards!
Cvar = kartslipdash

MenuItem BUMPSPARK
Text = Bump Spark
Tooltip = Don't lose driftspark after wallbump.
Cvar = kartbumpspark

MenuItem BUMPSPRING
Text = Bump Spring
Tooltip = Don't lose pogospring state after wallbump.
Cvar = kartbumpspring

MenuItem STACKING
Text = Boost Stacking
Tooltip = Allows boosts to combine to become stronger!
Cvar = kartstacking

MenuItem CHAINING
Text = Boost Chaining
Tooltip = Extend the length of boosts with other boosts!
Cvar = kartchaining

MenuItem CHAINOFFROAD
Text = Chain Offroad
Tooltip = Should extended sneakers mow offroad?
Cvar = kartchaining_chainoffroad

MenuItem SLOPEBOOST
Text = Slope Boost
Tooltip = When you go down slopes you go faster!
Cvar = kartslopeboost

MenuItem IVINTYPE
Text = Invincibility Type
Tooltip = Alternative Invincibility balance. \n Alternative used as "powergap" catchup.
Cvar = kartinvintype


Menu OP_BLANKARTBOT
X = 30
Y = 40
LineHeight = 10
HeaderPic = M_GAME
MenuItem DIFFICULTY
Text = Bot Difficulty
Tooltip = How difficult should bots be?
Cvar = kartbot

MenuItem COMPLEXITY
Text = Base Complexity
Tooltip = Force a track complexity value. Uses map default otherwise.
Cvar = kartbot_basetrackcomplexity

MenuItem MODIFIER
Text = Max Complexity Modifier
Tooltip = Force a max track complexity value. Uses map default otherwise.
Cvar = kartbot_modifiermax



