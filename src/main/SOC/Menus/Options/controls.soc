Menu OP_CONTROLSETUP
X = 60
Y = 40
LineHeight = 10
HeaderPic = M_CONTRO
MenuItem P1CONTROLS
Text = Player 1 Controls...
Tooltip = Setup player 1 controls.
Argument = 0
SubMenu = OP_CHANGECONTROLS

MenuItem P2CONTROLS
Text = Player 2 Controls...
Tooltip = Setup player 2 controls.
Argument = 1
SubMenu = OP_CHANGECONTROLS

MenuItem P3CONTROLS
Text = Player 3 Controls...
Tooltip = Setup player 3 controls.
Argument = 2
SubMenu = OP_CHANGECONTROLS

MenuItem P4CONTROLS
Text = Player 4 Controls...
Tooltip = Setup player 4 controls.
Argument = 3
SubMenu = OP_CHANGECONTROLS

MenuItem CONTROLPERKEY
OfsY = 10
Text = Controls per key
Tooltip = Allowed amount of controls per key.
Cvar = controlperkey


Menu OP_CHANGECONTROLS
X = 20
Y = 40
ScrollHeight = 134
CursorOffset = 6
HeaderPic = M_CONTRO
EnterRoutine = MR_SetupControlsMenu
MenuItem WHICH1
Overlay = True
X = 160
Y = 28
Style = center
Text = ^6Press ^2ENTER^6 to change, ^2BACKSPACE^6 to clear

MenuItem SETJOY
Text = Select Gamepad...
Argument = 0
Tooltip = Select your gamepad!
SubMenu = OP_JOYSTICKSET

MenuItem LEDCOLOR
Text = LED Color
Tooltip = Decide what happens with LED colors on supported gamepads.
Cvar = gamepadled

MenuItem RUMBLE
Text = Rumble
Tooltip = Vibrate the gamepad during certain actions.
Cvar = rumble

MenuItem RUMBLESTR
Text = Rumble Strength
Tooltip = The strength of gamepad vibration.
Cvar = rumblestrength

MenuItem TURNSMOOTHING
Text = Digital Turn Easing
Tooltip = Turn smoothing for non-analog turning.
Cvar = turnsmoothing

MenuItem LITESTEER
Text = Digital Lite Steer
Tooltip = Allow digital users to do shallow turns by holding back.
Cvar = litesteer

MenuItem TILTCONTROL
Text = Tilt Steering
Tooltip = Enable using the motion sensors on supported gamepads.
Cvar = tiltcontrol

MenuItem DEFAULTS
Text = Reset to defaults
Tooltip = Set controls to default.
Call = MR_ResetControls

MenuItem DEADZONEHEAD_

MenuItem DEADZONEHEAD
TempOffset = True
OfsX = 9
OfsY = -2
Style = header
Text = Deadzone

MenuItem XDEADZ
Text = X Deadzone
Tooltip = Minimum Range for analog x recognition.
Cvar = xdeadzone

MenuItem YDEADZ
Text = Y Deadzone
Tooltip = Minimum Range for analog y recognition.
Cvar = ydeadzone

MenuItem TDEADZ
Text = Trigger Deadzone
Tooltip = Minimum Range for analog trigger recognition.
Cvar = tdeadzone

MenuItem DEAZS
Text = Deadzone Style
Tooltip = Should deadzone function like SRB2Kart or Ring Racers.
Cvar = deadzonestyle

