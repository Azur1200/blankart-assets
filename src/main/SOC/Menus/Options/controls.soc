Menu OP_CONTROLSETUP
X = 60
Y = 30
HeaderPic = M_CONTRO
MenuItem P1CONTROLS
Y = 10
Text = Player 1 Controls...
Argument = 0
Call = MR_SetupControlsMenu

MenuItem P2CONTROLS
Y = 20
Text = Player 2 Controls...
Argument = 1
Call = MR_SetupControlsMenu

MenuItem P3CONTROLS
Y = 30
Text = Player 3 Controls...
Argument = 2
Call = MR_SetupControlsMenu

MenuItem P4CONTROLS
Y = 40
Text = Player 4 Controls...
Argument = 3
Call = MR_SetupControlsMenu

MenuItem CONTROLPERKEY
Y = 60
Text = Controls per key
Cvar = controlperkey

MenuItem TURNSMOOTHING
Y = 70
Text = Digital turn easing
Cvar = turnsmoothing


Menu OP_CHANGECONTROLS
