Menu OP_JOYSTICKSET
X = 50
Y = 40
HeaderPic = M_CONTRO
DrawRoutine = MD_DrawJoystick
MenuItem JOY1
Y = 16+5
Argument = 0
Call = MR_AssignJoystick

MenuItem JOY2
Y = (16*2)+5
Argument = 1
Call = MR_AssignJoystick

MenuItem JOY3
Y = (16*3)+5
Argument = 2
Call = MR_AssignJoystick

MenuItem JOY4
Y = (16*4)+5
Argument = 3
Call = MR_AssignJoystick

