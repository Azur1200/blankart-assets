MenuPanel OP_SERVER
LineHeight = 10
ScrollHeight = 144
Items
NAME
	Text = Server Name
	Tooltip = Name of server.
	Cvar = servername
INTERTIME
	OfsY = 4
	Text = Intermission Timer
	Tooltip = Length of intermission after races.
	Cvar = inttime
ADVANCEMAP
	Text = Map Progression
	Tooltip = How the next map to be played is choosen.
	Cvar = advancemap
VOTETIME
	Text = Voting Timer
	Tooltip = How long map voting is.
	Cvar = votetime
VOTEROWS
	Text = Voting Row Amount
	Tooltip = Maximum rows shown during voting.
	Cvar = votemaxrows
VOTECHANGES
	Text = Voting Rule Changes
	Tooltip = How often should other gamemodes appear.
	Cvar = kartvoterulechanges
VOTEENCORE
	Text = Voting Encore Rules
	Tooltip = How should encore function.
	Cvar = kartencorevotes
MAXPLAYERS
	OfsY = 10
	Text = Max. Player Count
	Tooltip = Max amount of players allowed in this server.
	Cvar = maxplayers
ALLOWJOIN
	Text = Allow Players to Join
	Tooltip = Allow players to join this server.
	Cvar = allowjoin
DOWNLOADING
	Text = Allow Addon Downloading
	Tooltip = Allow players to download addons.
	Cvar = downloading
PAUSING
	Text = Pause Permission
	Tooltip = Who has permission to pause the server?
	Cvar = pausepermission
MUTECHAT
	Text = Mute All Chat
	Tooltip = Completely mute in game chat.
	Cvar = mute
LAGLESS
	Text = Lagless
	Tooltip = Decide how to handle server player ping simulation.
	Cvar = lagless
ADVANCED
	Text = Advanced Options...
	Tooltip = Options for advanced server settings.
	Submenu = OP_ADVANCEDSERVER


MenuPanel OP_ADVANCEDSERVER
LineHeight = 10
Items
MASTERSERVER
	Text = Server Browser Address
	Tooltip = Server used for master server.
	Cvar = masterserver
RESYNCHATTEMPTS
	OfsY = 4
	Text = Attempts to resynchronise
	Tooltip = Attempts to resynchronise player to server.
	Cvar = resynchattempts
MAXDELAY
	Text = Ping limit (ms)
	Tooltip = Maximum allowed delay.
	Cvar = maxdelay
MAXDELAYTIMEOUT
	Text = Ping timeout (s)
	Tooltip = Delay timeout in seconds.
	Cvar = maxdelaytimeout
NETTIMEOUT
	Text = Connection timeout (tics)
	Tooltip = Connection timeout in tics.
	Cvar = nettimeout
JOINTIMEOUT
	Text = Join timeout (tics)
	Tooltip = Join timeout in tics
	Cvar = jointimeout
MAXSEND
	OfsY = 10
	Text = Max. file transfer send (KB)
	Tooltip = Max file size sent in kilobytes.
	Cvar = maxsend
DOWNLOADSPEED
	Text = File transfer packet rate
	Tooltip = Packet rate for file transfers.
	Cvar = downloadspeed
SHOWJOINADDRESS
	OfsY = 10
	Text = Log join addresses
	Tooltip = Log ip addresses of players who join.
	Cvar = showjoinaddress
BLAMECFAIL
	Text = Log resyncs
	Tooltip = Log player resync attempts.
	Cvar = blamecfail
NOTICEDOWNLOAD
	Text = Log file transfers
	Tooltip = Log player file transfers.
	Cvar = noticedownload

