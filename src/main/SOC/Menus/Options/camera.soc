MenuPanel OP_CAMERA
LineHeight = 10
Items
HEADER
	Style = header
	Text = Camera Options
TILTING
	OfsY = 10
	Text = Camera Tilting
	Tooltip = Camera rotation during gameplay.
	Cvar = tilting
NATURAL
	Text = Natural Camera
	Tooltip = Makes the camera zoom out as you pass your base speed.
	Cvar = naturalcamera
P1CAMERA
	OfsY = 10
	Text = Player 1 Camera options...
	Tooltip = Adjust Camera options of player 1.
	Argument = 0
	Submenu = OP_CAMERASETUP
P2CAMERA
	Text = Player 2 Camera options...
	Tooltip = Adjust Camera options of player 2.
	Argument = 1
	Submenu = OP_CAMERASETUP
P3CAMERA
	Text = Player 3 Camera options...
	Tooltip = Adjust Camera options of player 3.
	Argument = 2
	Submenu = OP_CAMERASETUP
P4CAMERA
	Text = Player 4 Camera options...
	Tooltip = Adjust Camera options of player 4.
	Argument = 3
	Submenu = OP_CAMERASETUP

MenuPanel OP_CAMERASETUP
Initializer = MP_CameraSetup
LineHeight = 10
Items
HEADER
	Style = header
	Text = Camera Options
FLIPCAM
	OfsY = 20
	Text = Flipcam
	Tooltip = Should the camera flip on gravity flipped sections?
	Cvar = flipcam
CAMFOV
	Text = Camera FOV
	Tooltip = Camera field of view.
	Argument = FRACUNIT
	Cvar = fov
CAMDISTANCE
	Text = Camera Distance
	Tooltip = Camera distance relative to the Player.
	Argument = FRACUNIT
	Cvar = cam_dist
CAMHEIGHT
	Text = Camera Height
	Tooltip = Height of the Camera.
	Argument = FRACUNIT
	Cvar = cam_height
CAMSPEED
	Text = Camera Speed
	Tooltip = Speed of the Camera.
	Cvar = cam_speed
CHASECAM
	OfsY = 5
	Text = Third Person Camera
	Tooltip = Toggle between Third or First Person camera.
	Cvar = chasecam

Menu OP_CAMERA
Panels
MAIN : OP_CAMERA
	X = 30
	Y = 30

Menu OP_CAMERASETUP
EnterRoutine = MR_SetupControlsMenu
Panels
MAIN : OP_CAMERASETUP
	X = 30
	Y = 30
