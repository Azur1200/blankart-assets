Menu OP_CAMERA
X = 30
Y = 30
LineHeight = 10
MenuItem HEADER
Style = header
Text = Camera Options

MenuItem TILTING
OfsY = 10
Text = Camera Tilting
Cvar = tilting

MenuItem LAGLESS
Text = Lagless Camera
Cvar = laglesscamera

MenuItem P1CAMERA
OfsY = 10
Text = Player 1 Camera options...
Argument = 0
Submenu = OP_CAMERASETUP

MenuItem P2CAMERA
Text = Player 2 Camera options...
Argument = 1
Submenu = OP_CAMERASETUP

MenuItem P3CAMERA
Text = Player 3 Camera options...
Argument = 2
Submenu = OP_CAMERASETUP

MenuItem P4CAMERA
Text = Player 4 Camera options...
Argument = 3
Submenu = OP_CAMERASETUP


Menu OP_CAMERASETUP
X = 30
Y = 30
LineHeight = 10
EnterRoutine = MR_CameraSetup
MenuItem HEADER
Style = header
Text = Camera Options

MenuItem FLIPCAM
OfsY = 20
Text = Flipcam
Cvar = flipcam

MenuItem CAMDISTANCE
Text = Camera Distance
Argument = FRACUNIT
Cvar = cam_dist

MenuItem CAMHEIGHT
Text = Camera Height
Argument = FRACUNIT
Cvar = cam_height

MenuItem CAMSPEED
Text = Camera Speed
Cvar = cam_speed

MenuItem CHASECAM
OfsY = 5
Text = Third Person Camera
Cvar = chasecam
