MenuPanel OP_DATA
LineHeight = 10
Items
SCREENSHOTS
	Text = Screenshot Options...
	Tooltip = Adjust the options of taking screenshots.
	SubMenu = OP_SCREENSHOTS
ADDONS
	Text = Addon Options...
	Tooltip = Adjust the settings of addon loading.
	SubMenu = OP_ADDONS
REPLAYS
	Text = Replay Options...
	Tooltip = Adjust replay options.
	Submenu = MISC_REPLAYOPTIONS
DISCORD
	Text = Discord Options...
	Tooltip = Adjust Discord options.
	Submenu = OP_DISCORD
ERASE
	OfsY = 10
	Text = Erase Data...
	Tooltip = Erase data of many types.
	Submenu = OP_ERASEDATA

MenuPanel MISC_REPLAYOPTIONS
LineHeight = 10
Items
RECORD
	Text = Record Replays
	Tooltip = Record online replays.
	Cvar = netdemo_record
SYNCQUALITY
	Text = Sync Check Interval
	Tooltip = Interval to record sync checks.
	Cvar = netdemo_syncquality
DATEFORMAT
	Text = Replay Date Format
	Tooltip = Change the format of which replay dates are displayed.
	Cvar = netdemo_dateformat

MenuPanel OP_SCREENSHOTS
Initializer = MP_ScreenshotOptions
LineHeight = 10
Items
LOCATION
	Text = Storage Location
	Tooltip = Location of screenshots.
	Cvar = screenshot_option
FOLDER
	Text = Custom Folder
	Tooltip = Path to screenshot folder.
	Cvar = screenshot_folder
SCREENSHOTHEADER
	Y = 40
	Style = header
	Text = Screenshots (F8)
MEMORY
	Text = Memory Level
	Tooltip = Amount of memory used by PNG screenshots 
	Cvar = png_memory_level
COMPRESSION
	Text = Compression Level
	Tooltip = PNG compression level of screenshots.
	Cvar = png_compress_level
STRATEGY
	Text = Strategy
	Tooltip = PNG Strategy.
	Cvar = png_strategy
WINDOWSIZE
	Text = Window Size
	Tooltip = PNG Image size.
	Cvar = png_window_size
MOVIEHEADER
	OfsY = 5
	Style = header
	Text = Movie Mode (F9)
MOVIEMODE
	Text = Capture Mode
	Tooltip = How movies are captured.
	Cvar = moviemode_mode
GIFOPTIMIZE
	Text = Region Optimizing
	Tooltip = GIF optimization.
	Cvar = gif_optimize
GIFDOWNSCALE
	Text = Downscaling
	Tooltip = Should GIFs be downscaled?
	Cvar = gif_downscale
APNGMEMORY
	Text = Memory Level
	Tooltip = Amount of memory used by APNG movies 
	Cvar = apng_memory_level
APNGCOMPRESSION
	Text = Compression Level
	Tooltip = APNG compression level of movies.
	Cvar = apng_compress_level
APNGSTRATEGY
	Text = Strategy
	Tooltip = APNG Strategy.
	Cvar = apng_strategy
APNGWINDOW
	Text = Window Size
	Tooltip = APNG Image size.
	Cvar = apng_window_size

MenuPanel OP_ADDONS
Initializer = MP_AddonsOptions
LineHeight = 10
Items
HEADER
	Style = header
	Text = Menu
LOCATION
	Text = Location
	Cvar = addons_option
FOLDER
	Text = Custom Folder
	Tooltip = Path of custom folder.
	Cvar = addons_folder
USEHASH
	Y = 48
	Text = Identify addons via
	Tooltip = How should addons be determined.
	Cvar = addons_md5
SHOWALL
	Text = Show unsupported file types
	Tooltip = Show unsupported file types.
	Cvar = addons_showall
SEARCHHEADER
	OfsY = 8
	Style = header
	Text = Search
SEARCHTYPE
	Text = Matching
	Tooltip = Search type.
	Cvar = addons_search_type
SEARCHCASE
	Text = Case-sensitive
	Tooltip = Case use for searching.
	Cvar = addons_search_case

MenuPanel OP_DISCORD
LineHeight = 10
Items
RICHPRESENCE
	Text = Rich Presence
	Tooltip = Discord Rich Presence.
	Cvar = discordrp
HEADER
	OfsY = 10
	Style = header
	Text = Rich Presence Settings
STREAMER
	Text = Streamer Mode
	Tooltip = Hides certain discord info while streaming.
	Cvar = discordstreamer
ASKTOJOIN
	OfsY = 10
	Text = Allow Ask To Join
	Tooltip = Allow being asked to join.
	Cvar = discordasks
INVITES
	Text = Allow Invites
	Tooltip = Allow invites.
	Cvar = discordinvites

MenuPanel OP_ERASEDATA
LineHeight = 10
Items
RECORDS
	Text = Erase Record Data
	Tooltip = Erase record data.
	Argument = 0
	Call = MR_EraseData
UNLOCKABLES
	Text = Erase Unlockable Data
	Tooltip = Erase earned unlock data.
	Argument = 1
	Call = MR_EraseData
EVERYTHING
	OfsY = 10
	Text = \85Erase ALL Data
	Tooltip = <red>Destruction of the world as we know it.
	Argument = 2
	Call = MR_EraseData

