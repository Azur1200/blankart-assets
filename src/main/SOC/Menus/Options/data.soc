Menu OP_DATA
X = 60
Y = 40
LineHeight = 10
HeaderPic = M_DATA
MenuItem SCREENSHOTS
Text = Screenshot Options...
Tooltip = Adjust the options of taking screenshots.
SubMenu = OP_SCREENSHOTS

MenuItem ADDONS
Text = Addon Options...
Tooltip = Adjust the settings of addon loading.
SubMenu = OP_ADDONS

MenuItem REPLAYS
Text = Replay Options...
Tooltip = Adjust replay options.
Submenu = MISC_REPLAYOPTIONS

MenuItem DISCORD
Text = Discord Options...
Tooltip = Adjust Discord options.
Submenu = OP_DISCORD

MenuItem ERASE
OfsY = 10
Text = Erase Data...
Tooltip = Erase data of many types.
Submenu = OP_ERASEDATA


Menu MISC_REPLAYOPTIONS
X = 27
Y = 40
LineHeight = 10
HeaderPic = M_REPOPT
MenuItem RECORD
Text = Record Replays
Tooltip = Record online replays.
Cvar = netdemo_record

MenuItem SYNCQUALITY
Text = Sync Check Interval
Tooltip = Interval to record sync checks.
Cvar = netdemo_syncquality


Menu OP_SCREENSHOTS
X = 30
Y = 40
LineHeight = 10
HeaderPic = M_SCSHOT
