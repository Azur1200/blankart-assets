MenuItem SHOWINPUT
Text = Input Display
Cvar = showinput

MenuItem CHECK
Text = Show "CHECK"
Cvar = kartcheck

MenuItem OFFSETS
Text = HUD Offsets...
Submenu = OP_OFFSET


