MenuPanel OP_HUD
LineHeight = 10
Items
SHOWHUD
	Text = Show HUD (F3)
	Tooltip = Should in-game HUD be shown?
	Cvar = showhud
TRANSLUCENT
	Text = HUD Visibility
	Tooltip = How translucent are HUD elements?
	Slider = translucenthud
CHATHUD
	OfsY = 5
	Text = Online HUD options...
	Tooltip = Online HUD options.
	Submenu = OP_CHAT
GAMEHUD
	Text = Game HUD options...
	Tooltip = Gameplay HUD options.
	Submenu = OP_GAMEHUD
BACKCOLOR
	Text = Background Glass
	Tooltip = Console and chat background color.
	Cvar = con_backcolor
HIGHLIGHT
	OfsY = 5
	Text = Menu Highlights
	Tooltip = Menu hightlight color.
	Cvar = menuhighlight
HLTEST1
	X = -2
	Style = highlight
	Text = (
HLTEST2
	X = 6
	OfsY = -10
	Style = recommendedhighlight
	Text = Good highlight
HLTEST3
	X = 114
	OfsY = -10
	Style = highlight
	Text = ,
HLTEST4
	X = 122
	OfsY = -10
	Style = warninghighlight
	Text = Warning highlight
HLTEST5
	X = 254
	OfsY = -10
	Style = highlight
	Text = )
MENUCAPS
	OfsX = -254
	OfsY = 5
	Text = Uppercase Menus
	Tooltip = Should menus be in all caps?
	Cvar = menucaps
TEXTSIZE
	Text = Console Text Size
	Tooltip = Size of console text.
	Cvar = con_textsize
FOCUSLOST
	Text = Show "FOCUS LOST"
	Tooltip = Show "FOCUS LOST" when window is not active.
	Cvar = showfocuslost
ALLMAPS
	Text = Show All Maps
	Tooltip = Show all maps (including hell maps) in the menu.
	Cvar = showallmaps

# Ok it's still called chatoptions but we'll put ping display in here to be clean
MenuPanel OP_CHAT
LineHeight = 10
# will ANYONE who doesn't know how to use the console want to touch this one?
# nonetheless...
Items
CHATMODE
	Text = Chat Mode
	Tooltip = Determine how chat display looks in game.
	Cvar = chatmode
CHATCHARCAP
	Text = Chat Limit Display
	Tooltip = Display current and maximum amount of chat characters entered.
	Cvar = chat_showlimit
CHATWIDTH
	OfsY = 5
	Text = Chat Box Width
	Tooltip = Width of chat box window.
	Slider = chatwidth
CHATHEIGHT
	Text = Chat Box Height
	Tooltip = Height of chat box window.
	Slider = chatheight
CHATXOFS
	Text = Chat Box X Offset
	Tooltip = X offset of chat box window.
	Slider = chat_xoffset
CHATYOFS
	Text = Chat Box Y Offset
	Tooltip = Y offset of chat box window.
	Slider = chat_yoffset
CHATBACKTINT
	OfsY = 5
	Text = Chat Background Tint
	Tooltip = Background on chat box window.
	Cvar = chatbacktint
CHATTIME
	Text = Message Fadeout Time
	Tooltip = Time until chat message fades out.
	Cvar = chattime
CHATSPAM
	Text = Spam Protection
	Tooltip = Prevents chat spam.
	Cvar = chatspamprotection
# shows ping next to framerate if we want to.
SHOWPING
	OfsY = 10
	Text = Local ping display
	Tooltip = Shows current ping when online.
	Cvar = showping
PINGICON
	Text = Ping display icon
	Tooltip = Show ping icon when showing ping.
	Cvar = pingicon
pingstyle
	Text = Ping Display Style
	Tooltip = Change how the ping display looks visually.
	Cvar = pingstyle
nodeip
	Text = Show IP address in playerlist
	Tooltip = Should Player IP addresses be printed in the nodes or listplayers command?
	Cvar = showipinnodelist

MenuPanel OP_GAMEHUD
LineHeight = 10
ScrollHeight = 144
Items
MINIMAPHEAD
	Style = header
	Text = Minimap
MINISTYLE
	Text = Minimap Style
	Tooltip = How should icons on the minimap display?
	Cvar = minimapstyle
MINIVISI
	Text = Minimap Visibility
	Tooltip = How translucent is the minimap?
	Slider = kartminimap
MINISMALL
	Text = Small Minimap Players
	Tooltip = Scale minimap player and object icons smaller.
	Cvar = smallminimapplayers
MININAMETAGS
	Text = Minimap Nametags
	Tooltip = Show the names of players on the minimap.
	Cvar = showminimapnames
MINIANGLE
	Text = Minimap Angle
	Tooltip = Show the angle of the current player on the minimap.
	Cvar = showminimapangle
MINIFINISHED
	Text = Finished Minimap Players
	Tooltip = Show finished players on the minimap.
	Cvar = showfinishedplayers
COLORHUDHEAD
	OfsY = 10
	Style = header
	Text = Color HUD
COLORIZE
	Text = Colorized HUD
	Tooltip = Enable colourized hud.
	Cvar = colorizedhud
COLORIZECOLOR
	Text = Colorized HUD Color
	Tooltip = The HUD color to use when colourized HUD is enabled.
	Cvar = colorizedhudcolor
COLORIZEITEMBOX
	Text = Colorized Itembox
	Tooltip = Enable the colourized itembox when colourized HUD is enabled.
	Cvar = colorizeditembox
DARKITEMBOX
	Text = Darken Itembox
	Tooltip = Darken the itembox when certain items are inside it.
	Cvar = darkitembox
LAPHEAD
	OfsY = 10
	Style = header
	Text = Lap Emblem
LAPEMBLEM
	Text = Lap Emblem and Splits
	Tooltip = Decide if lap emblems and splits are shown.
	Cvar = showlapemblem
SPLITSTYLE
	Text = Splits Style
	Tooltip = Decide how lap splits are shown.
	Cvar = lapemblemmode
SPLITTIME
	Text = Splits Time
	Tooltip = Decide who's time to show in splits.
	Cvar = racesplits
NAMETAGHEAD
	OfsY = 10
	Style = header
	Text = Nametags
NAMETAGS
	Text = Nametags
	Tooltip = Show the name of players online.
	Cvar = seenames
NAMETAGRESTAT
	Text = Nametag Restat
	Tooltip = Show the restat of players online.
	Cvar = seenamerestat
NAMETAGOWN
	Text = Show own Nametag
	Tooltip = Show your own name.
	Cvar = seeownname
SPEEDOMETERHEAD
	OfsY = 10
	Style = header
	Text = Speedometer
SPEEDOMETER
	Text = Speedometer Display
	Tooltip = Display the current speed on the screen.
	Cvar = kartdisplayspeed
SPEEDSTYLE
	Text = Speedometer Style
	Tooltip = Change the visual style of the speedometer.
	Cvar = newspeedometer
DRIFTGAUGEHEAD
	OfsY = 10
	Style = header
	Text = Drift Gauge
DRIFTGAUGE
	Text = Drift Gauge
	Tooltip = Display how much drift you have.
	Cvar = kartdriftgauge
DRIFTGAUGEOFS
	Text = Drift Gauge Offset
	Tooltip = Adjust Drift Gauge offset.
	Cvar = kartdriftgaugeoffset
CHARACTERSELECTHEAD
	OfsY = 10
	Style = header
	Text = Character Select
# CSSSTYLE
# 	Text = Skin Select Menu
# 	Tooltip = Use a different style of Skin Select.
# 	Cvar = skinselectstyle
CSSSORT
	Text = Skin Select Sorting
	Tooltip = Changes the sorting order in the Grid Skin Select
	Cvar = skinselectsort
ITEMTIMERHEAD
	OfsY = 10
	Style = header
	Text = Item Timers
SHOWTIMER
	Text = Item Timers
	Tooltip = Show duration of boosts.
	Cvar = itemtimers
SHOWTIMERMODE
	Text = Item Timers Mode
	Tooltip = How should item timers display?
	Cvar = itemtimers_mode
SHOWDRAFT
	Text = Drafting Indicator
	Tooltip = Show progress of drafting.
	Cvar = draftindicator
MISCHEAD
	OfsY = 10
	Style = header
	Text = Misc HUD
SHOWINPUT
	Text = Input Display
	Tooltip = Show player inputs.
	Cvar = showinput
CHECK
	Text = Show "CHECK"
	Tooltip = Show the "CHECK" graphic when some is behind the player.
	Cvar = kartcheck
STATS
	Text = Show Stats
	Tooltip = Show your character stats.
	Cvar = showstats
POSSCALE
	Text = Postion Scaling
	Tooltip = Make the position number smoothly scale.
	Cvar = smoothposition
FANCYJIN
	Text = Animated Roulette
	Tooltip = Make the roulette do a fancy animation.
	Cvar = fancyroulette
HIRESPORT
	Text = High Resolution Ranks
	Tooltip = Use the Wanted icon for when the Rank icon would be used.
	Cvar = highresportrait
RIDERSTICKER
	Text = Player Finish Ticker
	Tooltip = Show when each player ends the race on the HUD.
	Cvar = ridersfinishticker
OFFSETS
	OfsY = 10
	Text = HUD Offsets...
	Tooltip = Adjust HUD offsets.
	Submenu = OP_OFFSET

