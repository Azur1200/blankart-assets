Menu OP_HUD
X = 30
Y = 30
HeaderPic = M_HUD
MenuItem SHOWHUD
Y = 20
Text = Show HUD (F3)
Cvar = showhud

MenuItem TRANSLUCENT
Y = 30
Text = HUD Visibility
Slider = translucenthud

MenuItem CHATHUD
Y = 45
Text = Online HUD options...
Submenu = OP_CHAT

MenuItem GAMEHUD
Y = 55
Text = Game HUD options...
Submenu = OP_GAMEHUD

MenuItem BACKCOLOR
Y = 65
Text = Background Glass
Cvar = con_backcolor

MenuItem HIGHLIGHT
Y = 80
Text = Menu Highlights
Cvar = menuhighlight
# highlight info - (GOOD HIGHLIGHT, WARNING HIGHLIGHT) - 105 (see M_DrawHUDOptions)

MenuItem MENUCAPS
Y = 105
Text = Uppercase Menus
Cvar = menucaps

MenuItem TEXTSIZE
Y = 115
Text = Console Text Size
Cvar = con_textsize

MenuItem FOCUSLOST
Y = 125
Text = Show "FOCUS LOST"
Cvar = showfocuslost


# Ok it's still called chatoptions but we'll put ping display in here to be clean
Menu OP_CHAT
X = 30
Y = 30
HeaderPic = M_HUD
# will ANYONE who doesn't know how to use the console want to touch this one?
# nonetheless...
MenuItem CHATMODE
Y = 10
Text = Chat Mode
Cvar = chatmode

MenuItem CHATWIDTH
Y = 25
Text = Chat Box Width
Slider = chatwidth

MenuItem CHATHEIGHT
Y = 35
Text = Chat Box Height
Slider = chatheight

MenuItem CHATBACKTINT
Y = 50
Text = Chat Background Tint
Cvar = chatbacktint

MenuItem CHATTIME
Y = 60
Text = Message Fadeout Time
Cvar = chattime

MenuItem CHATSPAM
Y = 70
Text = Spam Protection
Cvar = chatspamprotection

# shows ping next to framerate if we want to.
MenuItem SHOWPING
Y = 90
Text = Local ping display
Cvar = showping


