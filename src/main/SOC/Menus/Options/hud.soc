MenuItem MINIFINISHED
Text = Finished Minimap Players
Cvar = showfinishedplayers

MenuItem MININAMETAGS
Text = Minimap Nametags
Cvar = showminimapnames

MenuItem MINIANGLE
Text = Minimap Angle
