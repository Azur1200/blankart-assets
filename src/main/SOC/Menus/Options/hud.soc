Menu OP_HUD
X = 30
Y = 50
LineHeight = 10
HeaderPic = M_HUD
MenuItem SHOWHUD
Text = Show HUD (F3)
Cvar = showhud

MenuItem TRANSLUCENT
Text = HUD Visibility
Slider = translucenthud

MenuItem CHATHUD
OfsY = 5
Text = Online HUD options...
Submenu = OP_CHAT

MenuItem GAMEHUD
Text = Game HUD options...
Submenu = OP_GAMEHUD

MenuItem BACKCOLOR
Text = Background Glass
Cvar = con_backcolor

MenuItem HIGHLIGHT
OfsY = 5
Text = Menu Highlights
Cvar = menuhighlight

MenuItem HLTEST1
X = -2
Style = highlight
Text = (

MenuItem HLTEST2
X = 6
OfsY = -10
Style = recommendedhighlight
Text = Good highlight

MenuItem HLTEST3
X = 114
OfsY = -10
Style = highlight
Text = ,

MenuItem HLTEST4
X = 122
OfsY = -10
Style = warninghighlight
Text = Warning highlight

MenuItem HLTEST5
X = 254
OfsY = -10
Style = highlight
Text = )

MenuItem MENUCAPS
OfsX = -254
OfsY = 5
Text = Uppercase Menus
Cvar = menucaps

MenuItem TEXTSIZE
Text = Console Text Size
Cvar = con_textsize

MenuItem FOCUSLOST
Text = Show "FOCUS LOST"
Cvar = showfocuslost


# Ok it's still called chatoptions but we'll put ping display in here to be clean
Menu OP_CHAT
X = 30
Y = 40
LineHeight = 10
HeaderPic = M_HUD
# will ANYONE who doesn't know how to use the console want to touch this one?
# nonetheless...
MenuItem CHATMODE
Text = Chat Mode
Cvar = chatmode

MenuItem CHATWIDTH
OfsY = 5
Text = Chat Box Width
Slider = chatwidth

MenuItem CHATHEIGHT
Text = Chat Box Height
Slider = chatheight

MenuItem CHATBACKTINT
OfsY = 5
Text = Chat Background Tint
Cvar = chatbacktint

MenuItem CHATTIME
Text = Message Fadeout Time
Cvar = chattime

MenuItem CHATSPAM
Text = Spam Protection
Cvar = chatspamprotection

# shows ping next to framerate if we want to.
MenuItem SHOWPING
OfsY = 10
Text = Local ping display
Cvar = showping


Menu OP_GAMEHUD
