// A recreation of hardcode offroad dust.
Footstep OffroadDefault
{
    MobjType MT_WIPEOUTTRAIL
    SFX DSCDFM70
	CONE 20
    PUSHH 0.3
    PUSHV 0
    SPREAD 0
}

defaultOffroadFootstep OffroadDefault

Splash SplashDefault
{
    MobjType MT_WIPEOUTTRAIL
    SFX DSS3K4C
	NUMPARTICLES 10
	PushH 1
	PushV 3
}

